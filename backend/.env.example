# Copy to .env and fill in. Never commit the real .env file.

ENVIRONMENT=development

# Shared-secret API key clients must send as `X-API-Key`. Leave unset in
# development to allow unauthenticated local requests (ALLOW_NO_AUTH_IN_DEV);
# required in production.
BACKEND_API_KEY=
ALLOW_NO_AUTH_IN_DEV=true

# Required for every Gemini-backed tool (single-image VQA, captioning,
# cross-modal fusion, and change-VQA's natural-language answer).
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.8-flash

# "gemini" (default) calls Gemini directly. "qwen" uses the fine-tuned
# Qwen2.5-VL-3B + LoRA adapter (ml/vqa/inference.py, weights at
# models/vqa-lora/) — needs transformers/peft/accelerate
# installed and runs on CUDA, MPS, or CPU (auto-detected).
VQA_BACKEND=gemini

# Leave unset (or comment out) to use the coded default — an empty value
# here is a *present* override to "", not "unset", and will break the tool.
# CHANGE_CHECKPOINT_PATH=
CHANGE_DEVICE=cpu

# text_guided_grounding: Qwen2.5-VL-3B + grounding LoRA adapter (see
# ml/grounding/Grounding.ipynb, ml/grounding/satquery_grounding_inference.py). Requires a CUDA GPU;
# there is no CPU/Gemini fallback for pixel-accurate boxes.
# GROUNDING_ADAPTER_DIR=/path/to/models/grounding-lora
# GROUNDING_MODEL_ID=Qwen/Qwen2.5-VL-3B-Instruct

CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173

RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
# If unset: rate limiting is in-process only (correct for one worker).
# If set: rate limiting is enforced in Redis, correct across multiple
# worker processes/nodes. `brew install redis && brew services start redis`
# locally, or point at any reachable Redis instance.
REDIS_URL=redis://localhost:6379/0
